# Edge-secret gate — ENFORCING template. COPY THIS OUTSIDE THE REPO, then fill in
# the secret. Never commit a filled-in copy.
#
#   cp infra/devbox/edge/edge-secret.enabled.inc.example ~/bt-devbox/edge-secret.inc
#   $EDITOR ~/bt-devbox/edge-secret.inc          # paste a 32+ byte random secret
#   # in infra/.env.devbox:
#   BT_DEVBOX_EDGE_SECRET_INC=/Users/you/bt-devbox/edge-secret.inc
#
# Generate the secret with:
#   openssl rand -hex 32
#
# Then add a Cloudflare Transform Rule (HTTP Request Header Modification) on the
# dev-box hostnames that sets `x-bt-edge` to the SAME value. Requests that do not
# come through Cloudflare then get 444 (connection closed) from the api and demo
# origins, even with a forged Host header.
#
# Order of operations matters: create the Cloudflare rule FIRST, verify it, and
# only then switch this file in and reload — otherwise the api origin closes
# every connection, including your own.
map $http_x_bt_edge $bt_edge_ok {
    default                                                             0;
    "PASTE_THE_SAME_VALUE_AS_THE_CLOUDFLARE_TRANSFORM_RULE_HEADER_HERE" 1;
}

# BetterTrack DEV BOX env — copy to infra/.env.devbox and fill in.
# Runbook: docs/deploy/devbox.md. Config reference: PROJECTPLAN.md §11.
#
#   cp infra/.env.devbox.example infra/.env.devbox
#   $EDITOR infra/.env.devbox
#
# infra/.env.devbox is git-ignored (`.env.*`). Never commit a filled-in copy.
#
# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ MUST DIFFER FROM PRODUCTION — no exceptions                               ║
# ║                                                                           ║
# ║   SESSION_SECRET             a shared value lets a dev-box session cookie ║
# ║                              be replayed against production               ║
# ║   BT_DATA_ENCRYPTION_KEY     shared key ⇒ dev-box operators can decrypt   ║
# ║   BT_DATA_ENCRYPTION_KEY_ID  production TOTP/Discord records              ║
# ║   POSTGRES_PASSWORD          separate database, separate credential       ║
# ║   ADMIN_PASSWORD             this admin console is on the public internet ║
# ║   BT_GRAFANA_ADMIN_PASSWORD                                               ║
# ║   BT_DEVBOX_EDGE_SECRET_INC  (if enabled) its own edge secret             ║
# ║                                                                           ║
# ║ Generate every one of them fresh:                                         ║
# ║   openssl rand -hex 64        # SESSION_SECRET, BT_DATA_ENCRYPTION_KEY    ║
# ║   openssl rand -base64 24     # passwords                                 ║
# ║   openssl rand -hex 32        # edge secret                               ║
# ║                                                                           ║
# ║ This box also gets its OWN Postgres/Redis volumes (bt-devbox-*, see       ║
# ║ infra/docker-compose.devbox.yml) — it never touches the local dev DB on   ║
# ║ localhost:5432 or any production volume.                                  ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── Database ────────────────────────────────────────────────────────────────
# Wrong ⇒ api and worker fail their healthchecks and the stack never comes up.
# DATABASE_URL must use the compose service hostname `db`, not localhost, and its
# password must match POSTGRES_PASSWORD character for character.
POSTGRES_USER=bt
POSTGRES_PASSWORD=CHANGE_ME_DEVBOX_ONLY_STRONG_PASSWORD
POSTGRES_DB=bettertrack
DATABASE_URL=postgres://bt:CHANGE_ME_DEVBOX_ONLY_STRONG_PASSWORD@db:5432/bettertrack

# ── Redis ───────────────────────────────────────────────────────────────────
# Wrong ⇒ no BullMQ jobs, no rate-limit counters, no realtime fan-out.
REDIS_URL=redis://redis:6379

# ── API secrets ─────────────────────────────────────────────────────────────
# Session cookie signing key (64 random hex bytes; comma-separate to rotate).
# Reused from production ⇒ cross-environment session forgery. Too short ⇒ boot fails.
SESSION_SECRET=CHANGE_ME_64_RANDOM_HEX_BYTES

# Long-lived encryption for stored TOTP/Discord records. Compose REFUSES to start
# without the id and key (they use `${VAR:?}`). Change the key later without
# listing the old one in DECRYPT_KEYS ⇒ existing records become unreadable.
BT_DATA_ENCRYPTION_KEY_ID=devbox-2026
BT_DATA_ENCRYPTION_KEY=CHANGE_ME_64_RANDOM_HEX_BYTES
BT_DATA_ENCRYPTION_DECRYPT_KEYS=

# ── Topology (§4.6, §11) ────────────────────────────────────────────────────
# ONE scheme drives every public origin. The CORS allowlist, the session cookie's
# Secure flag, the SPA's runtime config.js, the rendered CSP and every generated
# link are DERIVED from these — get them wrong and the SPA loads but every API
# call is blocked by CORS, or login "succeeds" and the cookie is dropped.
#
# ── Naming shape A (default) ──
# Requires an edge certificate for *.dev.bettertrack.at. Cloudflare's free
# Universal SSL covers bettertrack.at and *.bettertrack.at only — ONE level. A
# second-level wildcard needs Advanced Certificate Manager (paid) or a per-host
# certificate. If https://web.dev.bettertrack.at shows a certificate error, that
# is this limit, and shape B below is the fix.
BT_MODE=subdomains
BT_DOMAIN=dev.bettertrack.at
BT_SUB_WEB=web
BT_SUB_API=api
BT_SUB_ADMIN=admin
BT_SUB_MOBILE=mobile
#
# ── Naming shape B (fallback, single-level hostnames) ──
# Covered by the free *.bettertrack.at certificate. Switch by editing THESE FIVE
# LINES ONLY — no compose file, nginx conf or Dockerfile changes. The demo origin
# follows automatically (the edge conf matches demo. and demo-dev. by regex) and
# the api-origin hardening follows too (its server block lists both shapes).
#   BT_DOMAIN=bettertrack.at
#   BT_SUB_WEB=web-dev
#   BT_SUB_API=api-dev
#   BT_SUB_ADMIN=admin-dev
#   BT_SUB_MOBILE=mobile-dev
# Under shape B the apex origin renders as the PRODUCTION hostname
# (bettertrack.at). Nothing points there, so the block is inert — but do not
# create a DNS record for the apex or www pointing at this box.
# Session cookies are host-only (no Domain attribute), so a dev-box cookie on
# api-dev.bettertrack.at is never sent to api.bettertrack.at. Sharing the parent
# domain is safe for cookies; it is NOT an excuse to share secrets.

# TLS scheme of the DERIVED origins. Blank = the subdomains-mode default (https),
# which is what you want: the browser reaches Cloudflare over https even though
# this origin listens on plain http. Setting false ⇒ non-Secure session cookies.
BT_TLS=

# Host port the front proxy binds. Cloudflare's proxy connects to the origin on
# :80 for http (SSL/TLS mode Flexible), so this is effectively fixed at 80 —
# changing it makes the box unreachable through Cloudflare. Port 80 must be free
# first (see the runbook: the current demo server holds it).
BT_HTTP_PORT=80

# Explicit origin overrides. These are exactly what derivation produces from the
# shape-A block above; they are spelled out so a mismatch is visible rather than
# silent. IF YOU SWITCH TO SHAPE B, UPDATE THESE THREE TOO (or blank all three
# and let derivation do it) — a stale value here wins over derivation and breaks
# CORS in a way that looks like a browser bug.
BT_API_ORIGIN=https://api.dev.bettertrack.at
BT_WEB_ORIGIN=https://web.dev.bettertrack.at
BT_ADMIN_ORIGIN=https://admin.dev.bettertrack.at
# The static product/mobile pages take no credentials and never enter the CORS
# allowlist; leave blank so they follow BT_DOMAIN.
BT_PRODUCT_ORIGIN=
BT_MOBILE_ORIGIN=

# ── Dev-box edge gate (infra/devbox/edge/) ──────────────────────────────────
# Blank ⇒ compose mounts the repo's DISABLED stub and the gate is open. Set an
# ABSOLUTE host path OUTSIDE this repo to enforce it (see the runbook). A path
# that does not exist ⇒ Docker creates a DIRECTORY there and nginx fails to boot.
BT_DEVBOX_EDGE_SECRET_INC=

# ── Registration mode (§6.12) — READ THIS ───────────────────────────────────
# There is NO env variable for it. The mode lives in the `app_settings` table and
# defaults to `closed` (apps/api/src/services/appSettings/appSettingsService.ts,
# DEFAULT_REGISTRATION_MODE) — the most closed setting the app supports, and the
# only one enforced in V1. That is the correct posture here: this box is on the
# public internet with an admin console on it, so nobody may self-register.
# After first boot, VERIFY it in the admin app (Settings → Registration mode) and
# leave it on Closed. Accounts are created by the admin, or by invite.

# ── First admin (seeded on first boot only) ─────────────────────────────────
# This login is publicly reachable. Give it a unique 24-byte password and, if you
# can, put Cloudflare Access in front of the admin origin as well (runbook →
# "Exposure"). Re-running the seed with an existing admin is a no-op.
ADMIN_EMAIL=devbox-admin@example.at
ADMIN_PASSWORD=
# Optional demo user — leave OFF. Pass it per-command instead:
#   docker compose … run --rm -e BT_SEED_DEMO=true -e BT_DEMO_PASSWORD api node dist/scripts/seed.js
BT_SEED_DEMO=false
BT_DEMO_PASSWORD=

# ── Rate limiting (§10) ─────────────────────────────────────────────────────
# Keyed off the client IP the api sees, which is only correct because the edge
# conf recovers CF-Connecting-IP. Raising these on a public box raises how much
# credential stuffing one source may attempt.
RATE_LIMIT_BURST_WINDOW_SEC=10
RATE_LIMIT_BURST_LIMIT=60

# ── Market data ─────────────────────────────────────────────────────────────
# Yahoo needs no key. `true` opts into Yahoo → Stooq failover for supported
# equities/ETFs; leave false unless you are specifically testing failover.
MARKET_FAILOVER_ENABLED=false

# ── SMTP (optional; OFF here) ───────────────────────────────────────────────
# Blank ⇒ the email channel is disabled, the app runs fully and sends are logged
# as `suppressed`. Consequence to know: invite emails are not delivered — copy
# the invite link out of the admin UI instead. Enable only with a throwaway
# mailbox; a dev box sending mail as the production sender damages that domain's
# reputation.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Push channels (optional; OFF here) ──────────────────────────────────────
# Wrong/borrowed credentials here would push dev-box notifications to real
# production devices. Leave blank unless you generate a separate pair.
BT_FCM_SERVICE_ACCOUNT_FILE=
BT_VAPID_PUBLIC_KEY=
BT_VAPID_PRIVATE_KEY=
BT_VAPID_SUBJECT=

# ── Browser Google Drive appdata (optional; OFF here) ───────────────────────
# Public Google Cloud SPA OAuth client id, injected when the web container
# starts. It works only if the dev-box web origin is registered as an
# authorized JavaScript origin in that Google client. Do not reuse the
# production client id just to see the button; create a Web application
# credential for drive.appdata or leave this blank to hide the Drive card.
# Restarting the web container applies it.
BT_GOOGLE_DRIVE_CLIENT_ID=

# ── Backups ─────────────────────────────────────────────────────────────────
# Dev-box data is disposable, so keep the window short. Nothing runs it
# automatically — the nightly dump is a host cron on the live box only.
BACKUP_RETENTION_DAYS=7

# ── Observability (§13.5 V5-P2) ─────────────────────────────────────────────
# Grafana and Prometheus are published to BT_OBS_BIND_HOST ONLY and are never
# routed through the public front proxy. 0.0.0.0 on this box would put an
# unauthenticated metrics surface on the internet — never set that.
BT_OBS_BIND_HOST=127.0.0.1
# Non-default host ports: the machine already runs dev servers and the local
# `bettertrack-dev` stack. A collision here makes `up -d` fail on port binding.
BT_GRAFANA_PORT=3011
BT_PROMETHEUS_PORT=9091
BT_GRAFANA_ADMIN_USER=admin
BT_GRAFANA_ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_BOOT
# External (outside-LAN) access to Grafana stays OFF. The api refuses to expose
# it at all while the password above is a placeholder.
BT_OBS_EXTERNAL_ACCESS=false
BT_GRAFANA_SERVE_FROM_SUB_PATH=false
BT_GRAFANA_ROOT_URL=http://localhost:3000/
BT_GRAFANA_ANON_ENABLED=false
BT_GRAFANA_PUBLIC_URL=
BT_METRICS_ENABLED=true
BT_METRICS_PORT=9464

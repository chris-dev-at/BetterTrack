{
  "name": "bettertrack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:infra": "docker compose -f infra/docker-compose.dev.yml up -d",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r typecheck && pnpm exec tsc --project e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rm -rf dist coverage .tsbuildinfo",
    "knowledge:build": "node factory/knowledge/build.mjs"
  },
  "devDependencies": {
    "@bettertrack/config": "workspace:*",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "fast-uri": "^3.1.6",
      "hono": "^4.12.34",
      "ioredis": "5.11.1",
      "ip-address": "^10.3.1",
      "qs": "^6.16.0",
      "socket.io-parser": "^4.2.7"
    }
  }
}

{
  "name": "bettertrack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:infra": "docker compose -f infra/docker-compose.dev.yml up -d",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rm -rf dist coverage .tsbuildinfo",
    "knowledge:build": "node factory/knowledge/build.mjs"
  },
  "devDependencies": {
    "@bettertrack/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.11.1",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "fast-uri": "^3.1.5",
      "hono": "^4.12.34",
      "ip-address": "^10.3.1",
      "socket.io-parser": "^4.2.7"
    }
  }
}

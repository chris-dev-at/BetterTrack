{
  "name": "@bettertrack/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/scripts/worker.ts",
    "worker:dev": "tsx watch src/scripts/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/scripts/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:production-compose": "tsx src/scripts/checkProductionCompose.ts",
    "check:openapi-coverage": "tsx src/scripts/checkOpenapiCoverage.ts",
    "check:migrations-immutable": "tsx src/scripts/checkMigrationsImmutable.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "build": "tsup",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "admin:break-glass": "tsx src/scripts/adminTwoFactorBreakGlass.ts",
    "repair:taxed-sell-snapshots": "tsx src/scripts/repairTaxedSellSnapshots.ts",
    "catchup:cash-fusion": "tsx src/scripts/catchUpCashFusion.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@bettertrack/contracts": "workspace:*",
    "@bettertrack/domain": "workspace:*",
    "@bull-board/api": "^8.5.0",
    "@bull-board/express": "^8.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/node": "^10.69.0",
    "@simplewebauthn/server": "^13.3.2",
    "bullmq": "^6.0.6",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.7",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "re2": "1.26.1",
    "socket.io": "^4.8.3",
    "uuidv7": "^1.0.2",
    "web-push": "^3.6.7",
    "yahoo-finance2": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bettertrack/config": "workspace:*",
    "@electric-sql/pglite": "^0.2.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/ioredis-mock": "^8.2.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.1",
    "ioredis-mock": "^8.9.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vitest": "^3.0.5"
  }
}

{
  "name": "@bettertrack/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./holdings": {
      "types": "./src/holdings.ts",
      "default": "./src/holdings.ts"
    },
    "./cashLedger": {
      "types": "./src/cashLedger.ts",
      "default": "./src/cashLedger.ts"
    },
    "./tax": {
      "types": "./src/tax.ts",
      "default": "./src/tax.ts"
    },
    "./seriesStats": {
      "types": "./src/seriesStats.ts",
      "default": "./src/seriesStats.ts"
    },
    "./settingsScope": {
      "types": "./src/settingsScope.ts",
      "default": "./src/settingsScope.ts"
    },
    "./vaultVectors": {
      "types": "./src/vaultVectors/index.ts",
      "default": "./src/vaultVectors/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@bettertrack/config": "workspace:*",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
